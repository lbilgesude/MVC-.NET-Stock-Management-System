@model IEnumerable<StokTakip.Models.DepoEslestirme>

@{
    ViewData["Title"] = "Depo Eşleştirmeleri";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>
                        Depo Eşleştirmeleri
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Başarı ve Hata Mesajları -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <a asp-action="Create" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Yeni Eşleştirme
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Ana Depo</th>
                                    <th>Alt Depo</th>
                                    <th>Durum</th>
                                    <th>Oluşturma Tarihi</th>
                                    <th>Güncelleme Tarihi</th>
                                    <th>Oluşturan</th>
                                    <th>Güncelleyen</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary">@item.Depo?.DepoAdi</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@item.AltDepo?.AltDepoAdi</span>
                                        </td>
                                        <td>
                                            @if (item.Statu)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i>Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times me-1"></i>Pasif
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <i class="fas fa-calendar-plus me-1"></i>
                                            @(item.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş")
                                        </td>
                                        <td>
                                            <i class="fas fa-calendar-edit me-1"></i>
                                            @(item.GuncellemeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Güncellenmemiş")
                                        </td>
                                        <td>
                                            @if (item.OlusturanKullaniciNavigation != null)
                                            {
                                                <span class="text-muted">
                                                    <i class="fas fa-user me-1"></i>
                                                    @($"{item.OlusturanKullaniciNavigation.KulAd} {item.OlusturanKullaniciNavigation.KulSoyad}")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Belirtilmemiş</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.GuncelleyenKullaniciNavigation != null)
                                            {
                                                <span class="text-muted">
                                                    <i class="fas fa-user-edit me-1"></i>
                                                    @($"{item.GuncelleyenKullaniciNavigation.KulAd} {item.GuncelleyenKullaniciNavigation.KulSoyad}")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Güncellenmemiş</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sayfa yüklendiğinde animasyonlar
        $(document).ready(function() {
            $('.card').hide().fadeIn(500);
            $('.table tbody tr').hide().fadeIn(800);
        });
    </script>
}
