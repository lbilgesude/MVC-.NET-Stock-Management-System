@model StokTakip.Models.StokDurum

@{
    ViewData["Title"] = "Stok Durum Kaydını Sil";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Stok Durum Kaydını Silme Onayı</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <h5 class="alert-heading">Emin misiniz?</h5>
                    <p>Aşağıdaki stok durum kaydını kalıcı olarak silmek üzeresiniz. Bu işlem, ürünün depodaki mevcut miktar kaydını yok edecektir.</p>
                    <hr>
                    <p class="mb-0">Bu işlem geri alınamaz.</p>
                </div>

                <h5>Silinecek Kaydın Bilgileri:</h5>
                <dl class="row mt-3">
                    <dt class="col-sm-4">Ürün Adı</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Stok.StokAd)</dd>

                    <dt class="col-sm-4">Depo</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DepoEslestirme.Depo.DepoAdi) - @Html.DisplayFor(model => model.DepoEslestirme.AltDepo.AltDepoAdi)</dd>

                    <dt class="col-sm-4">Silinecek Miktar</dt>
                    <dd class="col-sm-8"><strong>@Model.DurumMiktar.ToString("N2")</strong></dd>
                </dl>
            </div>
            <div class="card-footer text-end">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Evet, Kalıcı Olarak Sil" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>