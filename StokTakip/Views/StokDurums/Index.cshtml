@model IEnumerable<StokTakip.Models.StokDurum>

@{
    ViewData["Title"] = "Stok Durum Listesi";
}

<h1 class="mb-4">Stok Durum Listesi</h1>

<div class="row mb-3">
    <div class="col-md-5">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" name="SearchString" class="form-control" placeholder="Ürün Adı, Marka, Depo..." value="@ViewData["CurrentFilter"]" />
                <button class="btn btn-primary" type="submit">Ara</button>
            </div>
        </form>
    </div>
    <div class="col-md-7 text-end">
        <a href="#" class="btn btn-outline-success"><i class="fas fa-file-excel me-2"></i>Excel'e Aktar</a>
        <a href="#" class="btn btn-secondary">Pasif Stokları Göster</a>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Ürün Adı</th>
            <th>Marka</th>
            <th>Ana Depo</th>
            <th>Alt Depo</th>
            <th>Miktar</th>
            <th>Ölçü Birimi</th>
            <th>Durum</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Stok.StokAd)</td>
                <td>@Html.DisplayFor(modelItem => item.Stok.StokMarka)</td>
                <td>@Html.DisplayFor(modelItem => item.DepoEslestirme.Depo.DepoAdi)</td>
                <td>@Html.DisplayFor(modelItem => item.DepoEslestirme.AltDepo.AltDepoAdi)</td>
                <td>@Html.DisplayFor(modelItem => item.DurumMiktar)</td>
                <td>@Html.DisplayFor(modelItem => item.Stok.StokOlcuBirimNavigation.OlcuBirimAdi)</td>
                <td>
                    @if (item.Stok.Statu == true)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pasif</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-controller="Stoks" asp-action="Edit" asp-route-id="@item.StokId" class="btn btn-warning btn-sm" title="Düzenle">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a asp-controller="Stoks" asp-action="Details" asp-route-id="@item.StokId" class="btn btn-info btn-sm" title="Detaylar">
                        <i class="fas fa-search"></i>
                    </a>
                    <a asp-controller="Stoks" asp-action="Delete" asp-route-id="@item.StokId" class="btn btn-danger btn-sm" title="Sil">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>