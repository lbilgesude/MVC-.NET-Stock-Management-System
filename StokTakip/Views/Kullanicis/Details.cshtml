@model StokTakip.Models.Kullanici

@{
    ViewData["Title"] = "Kullanıcı Detayları";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-user me-2"></i>
                        Kullanıcı Detayları
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-user me-2"></i>Kullanıcı Adı
                                </label>
                                <div class="info-value">@Html.DisplayFor(model => model.KulUsername)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-lock me-2"></i>Şifre
                                </label>
                                <div class="info-value">@Html.DisplayFor(model => model.KulSifre)</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-id-card me-2"></i>Ad Soyad
                                </label>
                                <div class="info-value">@Model.KulAd @Model.KulSoyad</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-user-tag me-2"></i>Kullanıcı Tipi
                                </label>
                                <div class="info-value">@Html.DisplayFor(model => model.KulTipNavigation.KultipAdi)</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-toggle-on me-2"></i>Durum
                                </label>
                                <div class="info-value">
                                    @if (Model.Statu)
                                    {
                                        <span class="badge bg-success fs-6">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">Pasif</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-user-plus me-2"></i>Oluşturan Kullanıcı
                                </label>
                                <div class="info-value">@(Model.OlusturanKullaniciNavigation?.KulUsername ?? "N/A")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item mb-4">
                                <label class="info-label">
                                    <i class="fas fa-calendar-plus me-2"></i>Oluşturma Tarihi
                                </label>
                                <div class="info-value">@Html.DisplayFor(model => model.OlusturmaTarihi)</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.GuncelleyenKullanici != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-item mb-4">
                                    <label class="info-label">
                                        <i class="fas fa-user-edit me-2"></i>Güncelleyen Kullanıcı
                                    </label>
                                    <div class="info-value">@(Model.GuncelleyenKullaniciNavigation?.KulUsername ?? "N/A")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item mb-4">
                                    <label class="info-label">
                                        <i class="fas fa-calendar-check me-2"></i>Güncelleme Tarihi
                                    </label>
                                    <div class="info-value">@Html.DisplayFor(model => model.GuncellemeTarihi)</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg me-3">
                        <i class="fas fa-edit me-2"></i>Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left me-2"></i>Listeye Geri Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.info-item {
    padding: 1rem;
    background-color: #f8f9fa;
    border-radius: 0.5rem;
    border-left: 4px solid #0d6efd;
}

.info-label {
    font-weight: bold;
    color: #495057;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    display: block;
}

.info-value {
    font-size: 1.1rem;
    color: #212529;
}
</style>