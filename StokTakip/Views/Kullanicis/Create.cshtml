@model StokTakip.Models.Kullanici

@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        Yeni Kullanıcı Ekle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="KulUsername" class="form-label fw-bold">
                                        <i class="fas fa-user me-2"></i>Kullanıcı Adı
                                    </label>
                                    <input asp-for="KulUsername" class="form-control form-control-lg" placeholder="Kullanıcı adını girin" />
                                    <span asp-validation-for="KulUsername" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="KulSifre" class="form-label fw-bold">
                                        <i class="fas fa-lock me-2"></i>Şifre
                                    </label>
                                    <input asp-for="KulSifre" type="password" class="form-control form-control-lg" placeholder="Şifre girin" />
                                    <span asp-validation-for="KulSifre" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="KulAd" class="form-label fw-bold">
                                        <i class="fas fa-id-card me-2"></i>Ad
                                    </label>
                                    <input asp-for="KulAd" class="form-control form-control-lg" placeholder="Adını girin" />
                                    <span asp-validation-for="KulAd" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="KulSoyad" class="form-label fw-bold">
                                        <i class="fas fa-id-card me-2"></i>Soyad
                                    </label>
                                    <input asp-for="KulSoyad" class="form-control form-control-lg" placeholder="Soyadını girin" />
                                    <span asp-validation-for="KulSoyad" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-4">
                                    <label asp-for="KulTip" class="form-label fw-bold">
                                        <i class="fas fa-user-tag me-2"></i>Kullanıcı Tipi
                                    </label>
                                    <select asp-for="KulTip" class="form-select form-select-lg" asp-items="ViewBag.KulTip">
                                        <option value="">-- Kullanıcı Tipi Seçiniz --</option>
                                    </select>
                                    <span asp-validation-for="KulTip" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-toggle-on me-2"></i>Durum
                                    </label>
                                    <div class="form-check form-switch form-switch-lg">
                                        <input class="form-check-input" type="checkbox" asp-for="Statu" checked>
                                        <label class="form-check-label fw-bold" asp-for="Statu">
                                            Aktif
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-success btn-lg me-3">
                                    <i class="fas fa-plus me-2"></i>Kullanıcı Ekle
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-arrow-left me-2"></i>İptal
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}