@model StokTakip.Models.StokHareket

@{
    ViewData["Title"] = "Stok Hareket Düzenle";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Stok Hareket Düzenle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <!-- Sol Kolon -->
                            <div class="col-md-6">
                                <div class="card border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-box me-2"></i>Ürün ve Depo Bilgileri</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group mb-3">
                                            <label asp-for="StokId" class="form-label fw-bold">
                                                <i class="fas fa-box me-2"></i>Ürün
                                            </label>
                                            <select asp-for="StokId" class="form-select" asp-items="ViewBag.StokId">
                                                <option value="">-- Ürün Seçiniz --</option>
                                            </select>
                                            <span asp-validation-for="StokId" class="text-danger"></span>
                                        </div>
                                        
                                        <div class="form-group mb-3">
                                            <label asp-for="DepoEslestirmeId" class="form-label fw-bold">
                                                <i class="fas fa-warehouse me-2"></i>Depo Eşleştirmesi
                                            </label>
                                            <select asp-for="DepoEslestirmeId" class="form-select" asp-items="ViewBag.DepoEslestirmeId">
                                                <option value="">-- Depo Seçiniz --</option>
                                            </select>
                                            <span asp-validation-for="DepoEslestirmeId" class="text-danger"></span>
                                        </div>
                                        
                                        <div class="form-group mb-3">
                                            <label asp-for="SorumluId" class="form-label fw-bold">
                                                <i class="fas fa-user me-2"></i>Sorumlu
                                            </label>
                                            <select asp-for="SorumluId" class="form-select" asp-items="ViewBag.SorumluId">
                                                <option value="">-- Sorumlu Seçiniz --</option>
                                            </select>
                                            <span asp-validation-for="SorumluId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Sağ Kolon -->
                            <div class="col-md-6">
                                <div class="card border-success">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Hareket Detayları</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group mb-3">
                                            <label asp-for="HareketTip" class="form-label fw-bold">
                                                <i class="fas fa-exchange-alt me-2"></i>Hareket Tipi
                                            </label>
                                            <select asp-for="HareketTip" class="form-select" asp-items="ViewBag.HareketTip">
                                                <option value="">-- Hareket Tipi Seçiniz --</option>
                                            </select>
                                            <span asp-validation-for="HareketTip" class="text-danger"></span>
                                        </div>
                                        
                                        <div class="form-group mb-3">
                                            <label asp-for="HareketMiktar" class="form-label fw-bold">
                                                <i class="fas fa-balance-scale me-2"></i>Miktar
                                            </label>
                                            <input asp-for="HareketMiktar" class="form-control" type="number" step="0.01" min="0" />
                                            <span asp-validation-for="HareketMiktar" class="text-danger"></span>
                                        </div>
                                        
                                        <div class="form-group mb-3">
                                            <label asp-for="HareketTarihi" class="form-label fw-bold">
                                                <i class="fas fa-calendar me-2"></i>Hareket Tarihi
                                            </label>
                                            <input asp-for="HareketTarihi" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="HareketTarihi" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Açıklama -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card border-info">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-comment me-2"></i>Açıklama</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group">
                                            <textarea asp-for="Aciklama" class="form-control" rows="4" placeholder="Hareket hakkında açıklama giriniz..."></textarea>
                                            <span asp-validation-for="Aciklama" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Butonlar -->
                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-warning btn-lg me-3">
                                    <i class="fas fa-save me-2"></i>Güncelle
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg me-3">
                                    <i class="fas fa-arrow-left me-2"></i>İptal
                                </a>
                                <a asp-action="Details" asp-route-id="@Model?.Id" class="btn btn-info btn-lg">
                                    <i class="fas fa-eye me-2"></i>Detaylar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Form validasyonu
            $('form').on('submit', function() {
                if ($(this).valid()) {
                    $('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Güncelleniyor...');
                }
            });
            
            // Sayfa yüklendiğinde animasyonlar
            $('.card').hide().fadeIn(500);
            $('.form-group').hide().fadeIn(800);
        });
    </script>
}
