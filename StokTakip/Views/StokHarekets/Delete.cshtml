@model StokTakip.Models.StokHareket

@{
    ViewData["Title"] = "Stok Hareket Sil";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Stok Hareket Silme Onayı
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Dikkat!
                        </h4>
                        <p class="mb-0">
                            Bu stok hareketini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!
                        </p>
                    </div>

                    <div class="row">
                        <!-- Sol Kolon - Temel Bilgiler -->
                        <div class="col-md-6">
                            <div class="card border-warning">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-box me-2"></i>Silinecek Hareket Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Ürün:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-info fs-6">@(Model.Stok?.StokAd ?? "Belirtilmemiş")</span>
                                            @if (!string.IsNullOrEmpty(Model.Stok?.StokMarka))
                                            {
                                                <span class="badge bg-secondary ms-2">@Model.Stok.StokMarka</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Hareket Tipi:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-primary fs-6">@(Model.HareketTipNavigation?.HareketTipAdi ?? "Belirtilmemiş")</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Miktar:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-success fs-5">@Model.HareketMiktar</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Hareket Tarihi:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-calendar-alt me-2"></i>
                                            @Model.HareketTarihi.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ Kolon - Depo ve Sorumlu Bilgileri -->
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-warehouse me-2"></i>Depo ve Sorumlu Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Ana Depo:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-warning text-dark">@(Model.DepoEslestirme?.Depo?.DepoAdi ?? "Belirtilmemiş")</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Alt Depo:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-info text-dark">@(Model.DepoEslestirme?.AltDepo?.AltDepoAdi ?? "Belirtilmemiş")</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Sorumlu:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-secondary">@(Model.Sorumlu?.SorumluAdi ?? "Belirtilmemiş")</span>
                                        </div>
                                    </div>
                                                                            <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold">Oluşturan:</div>
                                            <div class="col-sm-8">
                                                <i class="fas fa-user me-2"></i>
                                                @(Model.OlusturanKullaniciNavigation != null ? $"{Model.OlusturanKullaniciNavigation.KulAd} {Model.OlusturanKullaniciNavigation.KulSoyad}" : "Belirtilmemiş")
                                            </div>
                                        </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    @if (!string.IsNullOrEmpty(Model.Aciklama))
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card border-secondary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-comment me-2"></i>Açıklama</h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-0">@Model.Aciklama</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Sistem Bilgileri -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-secondary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Sistem Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <small class="text-muted">
                                                <i class="fas fa-plus-circle me-1"></i>
                                                <strong>Oluşturma:</strong> @(Model.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş")
                                            </small>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted">
                                                <i class="fas fa-edit me-1"></i>
                                                <strong>Güncelleme:</strong> @(Model.GuncellemeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Güncellenmemiş")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                        <div>
                            <a asp-action="Details" asp-route-id="@Model?.Id" class="btn btn-info me-2">
                                <i class="fas fa-eye me-2"></i>Detaylar
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu stok hareketini silmek istediğinizden emin misiniz?');">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="fas fa-trash me-2"></i>Evet, Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Sayfa yüklendiğinde animasyonlar
            $('.card').hide().fadeIn(500);
            $('.alert').hide().fadeIn(800);
            
            // Silme onayı
            $('form').on('submit', function() {
                return confirm('Bu stok hareketini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!');
            });
        });
    </script>
}
