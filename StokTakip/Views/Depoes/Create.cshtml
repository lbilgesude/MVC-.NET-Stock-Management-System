@model StokTakip.Models.Depo

@{
    ViewData["Title"] = "Yeni Depo Ekle";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-warehouse me-2"></i>
                        Yeni Depo Ekle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-4">
                                    <label asp-for="DepoAdi" class="form-label fw-bold">
                                        <i class="fas fa-warehouse me-2"></i>Depo Adı
                                    </label>
                                    <input asp-for="DepoAdi" class="form-control form-control-lg" placeholder="Depo adını girin" />
                                    <span asp-validation-for="DepoAdi" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-toggle-on me-2"></i>Durum
                                    </label>
                                    <div class="form-check form-switch form-switch-lg">
                                        <input class="form-check-input" type="checkbox" asp-for="Statu" checked>
                                        <label class="form-check-label fw-bold" asp-for="Statu">
                                            Aktif
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-success btn-lg me-3">
                                    <i class="fas fa-plus me-2"></i>Depo Ekle
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-arrow-left me-2"></i>İptal
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}