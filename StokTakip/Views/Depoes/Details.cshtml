@model StokTakip.Models.Depo

@{
    ViewData["Title"] = "Depo Detayları";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-eye me-2"></i>
                        Depo Detayları
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Sol Kolon - Temel Bilgiler -->
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-warehouse me-2"></i>Depo Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Depo Adı:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-info fs-6">@Model.DepoAdi</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Durum:</div>
                                        <div class="col-sm-8">
                                            @if (Model.Statu)
                                            {
                                                <span class="badge bg-success fs-6">
                                                    <i class="fas fa-check me-1"></i>Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger fs-6">
                                                    <i class="fas fa-ban me-1"></i>Pasif
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Depo ID:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-secondary fs-6">#@Model.Id</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ Kolon - Sistem Bilgileri -->
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Sistem Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Oluşturan:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-user me-2"></i>
                                            @(Model.OlusturanKullaniciNavigation?.KulUsername ?? "Belirtilmemiş")
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Oluşturma Tarihi:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-calendar-plus me-2"></i>
                                            @(Model.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş")
                                        </div>
                                    </div>
                                    @if (Model.GuncelleyenKullanici != null)
                                    {
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold">Güncelleyen:</div>
                                            <div class="col-sm-8">
                                                <i class="fas fa-user-edit me-2"></i>
                                                @(Model.GuncelleyenKullaniciNavigation?.KulUsername ?? "Belirtilmemiş")
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold">Güncelleme Tarihi:</div>
                                            <div class="col-sm-8">
                                                <i class="fas fa-calendar-check me-2"></i>
                                                @(Model.GuncellemeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş")
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg me-3">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-2"></i>Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>