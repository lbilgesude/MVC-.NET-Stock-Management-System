@model StokTakip.Models.Depo

@{
    ViewData["Title"] = "Depo Sil";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Depo Silme Onayı
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            ⚠️ SİLME ONAYI GEREKLİ
                        </h4>
                        <p class="mb-2 fs-5">
                            <strong>@Model.DepoAdi</strong> adlı depoyu silmek istediğinizden emin misiniz?
                        </p>
                        <p class="mb-0 text-danger fw-bold">
                            <i class="fas fa-skull-crossbones me-2"></i>
                            Bu işlem geri alınamaz ve tüm ilgili veriler silinecektir!
                        </p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-warning">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-warehouse me-2"></i>Silinecek Depo Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Depo Adı:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-info fs-6">@Model.DepoAdi</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Durum:</div>
                                        <div class="col-sm-8">
                                            @if (Model.Statu)
                                            {
                                                <span class="badge bg-success fs-6">
                                                    <i class="fas fa-check me-1"></i>Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger fs-6">
                                                    <i class="fas fa-times me-1"></i>Pasif
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Silinecek Veriler</h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2">
                                            <i class="fas fa-box text-primary me-2"></i>
                                            <strong>Tüm Alt Depolar</strong>
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-boxes text-warning me-2"></i>
                                            <strong>Tüm Stok Durumları</strong>
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-exchange-alt text-info me-2"></i>
                                            <strong>Tüm Stok Hareketleri</strong>
                                        </li>
                                        <li class="mb-0">
                                            <i class="fas fa-link text-secondary me-2"></i>
                                            <strong>Tüm Eşleştirmeler</strong>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>İptal
                            </a>
                        </div>
                        <div>
                            <form asp-action="Delete" class="d-inline">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn btn-danger btn-lg px-4 py-3">
                                    <i class="fas fa-trash me-2"></i>
                                    <strong>EVET, EMİNİM - SİL</strong>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>