@model StokTakip.Models.AltDepoEditViewModel

@{
    ViewData["Title"] = "Alt Depo Düzenle";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Alt Depo Düzenle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.AltDepo.Id">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="AltDepo.Id" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-4">
                                    <label asp-for="AltDepo.AltDepoAdi" class="form-label fw-bold">
                                        <i class="fas fa-warehouse me-2"></i>Alt Depo Adı
                                    </label>
                                    <input asp-for="AltDepo.AltDepoAdi" class="form-control form-control-lg" placeholder="Alt depo adını girin" />
                                    <span asp-validation-for="AltDepo.AltDepoAdi" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-toggle-on me-2"></i>Durum
                                    </label>
                                    <div class="form-check form-switch form-switch-lg">
                                        <input class="form-check-input" asp-for="AltDepo.Statu" />
                                        <label class="form-check-label fw-bold" asp-for="AltDepo.Statu">
                                            Aktif
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="SeciliAnaDepoId" class="form-label fw-bold">
                                <i class="fas fa-link me-2"></i>Bağlı Olduğu Ana Depo
                            </label>
                            <select asp-for="SeciliAnaDepoId" class="form-select form-select-lg" asp-items="@Model.AnaDepoListesi">
                            </select>
                            <span asp-validation-for="SeciliAnaDepoId" class="text-danger"></span>
                        </div>


                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-warning btn-lg me-3">
                                    <i class="fas fa-save me-2"></i>Güncelle
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-arrow-left me-2"></i>İptal
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}