            console.log('Aktif kullanıcı verileri:', data);
            
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data && data.length > 0 ? data.map(d => d.Label) : ['Veri Yok'],
                    datasets: [{
