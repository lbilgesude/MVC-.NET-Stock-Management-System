    // Chart.js yüklendikten sonra grafikleri oluştur
    function waitForChart() {
        if (typeof Chart !== 'undefined') {
            console.log('Chart.js yüklendi, grafikler oluşturuluyor...');
            
            // Tüm grafikleri oluştur
            createAylikStokAkisChart();
            createHareketTipiChart();
            createDepoStokChart();
            createAltDepoStokChart();
            createGunlukTrendChart();
            createKritikStokChart();
            createAktifKullanicilarChart();
            createEnCokCikanUrunlerChart();
        } else {
            console.log('Chart.js henüz yüklenmedi, 100ms sonra tekrar denenecek...');
            setTimeout(waitForChart, 100);
        }
    }

    // Sayfa yüklendiğinde grafikleri oluştur
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Sayfa yüklendi, Chart.js bekleniyor...');
        waitForChart();
    });
</script>