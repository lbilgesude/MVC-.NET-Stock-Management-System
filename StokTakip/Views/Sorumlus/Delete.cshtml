@model StokTakip.Models.Sorumlu

@{
    ViewData["Title"] = "Sorumlu Sil";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Sorumlu Silme Onayı</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <h5 class="alert-heading">⚠️ DİKKAT: Bu işlem kapsamlıdır!</h5>
                    <p><strong>@Model.SorumluAdi</strong> adlı sorumluyu silmek istediğinizden emin misiniz?</p>
                    <hr>
                    <p class="mb-0 text-danger"><strong>Bu işlem şunları da silecektir:</strong></p>
                    <ul class="mb-0 mt-2">
                        <li>Bu sorumlunun yaptığı <strong>TÜM STOK HAREKETLERİ</strong></li>
                    </ul>
                    <p class="mt-2 mb-0 text-danger"><strong>Bu işlem geri alınamaz ve tüm ilgili veriler veritabanından tamamen silinecektir.</strong></p>
                </div>
            </div>
            <div class="card-footer text-end">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Evet, Tümünü Kalıcı Olarak Sil" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>