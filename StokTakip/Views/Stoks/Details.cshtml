@model StokTakip.Models.Stok

@{
    ViewData["Title"] = "Stok Detayları";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-box me-2"></i>
                        Stok Detayları
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Sol Kolon - Temel Bilgiler -->
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-box me-2"></i>Temel Bilgiler</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Stok Adı:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-info fs-6">@Model.StokAd</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Marka:</div>
                                        <div class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.StokMarka))
                                            {
                                                <span class="badge bg-secondary fs-6">@Model.StokMarka</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Belirtilmemiş</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Detay:</div>
                                        <div class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.StokDetay))
                                            {
                                                <span class="text-dark">@Model.StokDetay</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Belirtilmemiş</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Durum:</div>
                                        <div class="col-sm-8">
                                            @if (Model.Statu)
                                            {
                                                <span class="badge bg-success fs-6">
                                                    <i class="fas fa-check me-1"></i>Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger fs-6">
                                                    <i class="fas fa-times me-1"></i>Pasif
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ Kolon - Sistem Bilgileri -->
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Sistem Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Mevcut Miktar:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-warning text-dark fs-5">@ViewBag.GerçekMiktar</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Kayıt Tarihi:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-calendar-alt me-2"></i>
                                            @Model.KayitTarihi.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Oluşturma Tarihi:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-calendar-alt me-2"></i>
                                            @Model.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş"
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Güncelleme Tarihi:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-calendar-alt me-2"></i>
                                            @Model.GuncellemeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Güncellenmemiş"
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Oluşturan Kullanıcı:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-user me-2"></i>
                                            @(Model.OlusturanKullaniciNavigation != null ? $"{Model.OlusturanKullaniciNavigation.KulAd} {Model.OlusturanKullaniciNavigation.KulSoyad}" : "Belirtilmemiş")
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Güncelleyen Kullanıcı:</div>
                                        <div class="col-sm-8">
                                            <i class="fas fa-user-edit me-2"></i>
                                            @(Model.GuncelleyenKullaniciNavigation != null ? $"{Model.GuncelleyenKullaniciNavigation.KulAd} {Model.GuncelleyenKullaniciNavigation.KulSoyad}" : "Güncellenmemiş")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ölçü Birimi Bilgisi -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="fas fa-ruler me-2"></i>Ölçü Birimi</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <span class="badge bg-info fs-6">
                                                <i class="fas fa-ruler me-2"></i>
                                                @(Model.StokOlcuBirimNavigation?.OlcuBirimAdi ?? "Belirtilmemiş")
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Bu ürünün stok takibinde kullanılan ölçü birimi
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-lg me-3">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-2"></i>Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sayfa yüklendiğinde animasyonlar
        $(document).ready(function() {
            $('.card').hide().fadeIn(500);
            $('.badge').hide().fadeIn(800);
        });
    </script>
}