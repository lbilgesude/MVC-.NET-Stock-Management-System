@model StokTakip.Models.HomeViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

@if (TempData["MinimumStokUyarisi"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>⚠️ Minimum Stok Uyarısı!</strong> @TempData["MinimumStokUyarisi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div class="mt-2">
            <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(@TempData["AltDepoId"])">
                🎯 Alt Depo Tespit Et
            </button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="dismissAlert()">
                ❌ Kapat
            </button>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>✅ Başarılı!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="dashboard-header">
    <div class="welcome-section">
        <h1 class="welcome-title">Hoş Geldiniz!</h1>
        <p class="welcome-subtitle">Stok Takip Sistemi'ne hoş geldiniz. Güncel durumu görüntüleyin ve hızlı işlemler yapın.</p>
    </div>
    <div class="quick-actions">
        <a href="@Url.Action("Giris", "StokHarekets")" class="btn btn-success">
            <i class="fas fa-arrow-down"></i>
            Stok Girişi
        </a>
        <a href="@Url.Action("Cikis", "StokHarekets")" class="btn btn-warning">
            <i class="fas fa-arrow-up"></i>
            Stok Çıkışı
        </a>
        <a href="@Url.Action("Transfer", "StokHarekets")" class="btn btn-info">
            <i class="fas fa-exchange-alt"></i>
            Transfer
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-boxes"></i>
        </div>
        <div class="stat-content">
            <div class="stat-number">@Model.ToplamStokAdedi.ToString("N0")</div>
            <div class="stat-label">Toplam Stok Miktarı</div>
            <div class="stat-sublabel">@Model.ToplamStokKartiSayisi stok kartı</div>
        
        <div class="stat-trend positive">
            <i class="fas fa-arrow-up"></i>
            <span>+12%</span>
        </div></div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-warehouse"></i>
        </div>
        <div class="stat-content">
            <div class="stat-number">@Model.ToplamAnaDepoSayisi</div>
            <div class="stat-label">Toplam Depo</div>
       
        <div class="stat-trend positive">
            <i class="fas fa-arrow-up"></i>
            <span>+5%</span>
        </div> </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-content">
            <div class="stat-number">@Model.ToplamKullaniciSayisi</div>
            <div class="stat-label">Toplam Kullanıcı</div>
        
        <div class="stat-trend neutral">
            <i class="fas fa-minus"></i>
            <span>0%</span>
        </div></div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-chart-line"></i>
        </div>
        <div class="stat-content">
            <div class="stat-number">@Model.SonStokHareketleri.Count()</div>
            <div class="stat-label">Bu Ay Hareket</div>
        
        <div class="stat-trend positive">
            <i class="fas fa-arrow-up"></i>
            <span>+18%</span>
        </div></div>
    </div>
</div>

<div class="content-row">
    <div class="recent-activities">
        <div class="content-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clock"></i>
                    Son 10 Stok Hareketi
                </h3>
            </div>
            <div class="card-body">
                @if (Model.SonStokHareketleri != null && Model.SonStokHareketleri.Any())
                {
                    <div class="activity-list">
                        @foreach (var hareket in Model.SonStokHareketleri.Take(10))
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="text-dark @GetActivityIcon(hareket.HareketTip)"></i>
                                </div>
                                <div class="activity-content">
                                    <div class="activity-title">
                                        @GetActivityTypeText(hareket.HareketTip) - @(hareket.Stok?.StokAd ?? "N/A")
                                    </div>
                                    <div class="activity-details">
                                        <span class="activity-amount">@hareket.HareketMiktar @(hareket.Stok?.StokOlcuBirimNavigation?.OlcuBirimAdi ?? "")</span>
                                        <span class="activity-location">@(hareket.DepoEslestirme?.Depo?.DepoAdi ?? "N/A")</span>
                                    </div>
                                    <div class="activity-time">@hareket.HareketTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="activity-badge">
                                    <span class="@GetActivityBadgeClass(hareket.HareketTip)">
                                        @GetActivityTypeText(hareket.HareketTip)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Henüz stok hareketi bulunmuyor</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="minimum-stok-uyarilari">
        <div class="content-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">
                    <i class="fas fa-bell text-warning"></i>
                    Sistem Uyarıları
                    <span id="uyariSayisi" class="uyari-sayisi" style="display: none;">0</span>
                </h3>
                <button id="tumunuOkunduBtn" type="button" class="btn btn-sm btn-primary" onclick="markAllAsRead()" style="display: none;">
                    <i class="fas fa-check-double"></i> Tümünü Okundu İşaretle
                </button>
            </div>
            <div class="card-body">
                <div id="uyariListesi">
                    <!-- Uyarılar buraya dinamik olarak yüklenecek -->
                </div>
                
                <!-- Model'den gelen statik uyarılar (varsa) -->
                @if (Model.Uyarilar != null && Model.Uyarilar.Any())
                {
                    <div class="statik-uyarilar" style="margin-top: 1rem;">
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-info-circle"></i>
                            Sistem Bildirimleri
                        </h6>
                        <div class="uyari-listesi">
                            @foreach (var uyari in Model.Uyarilar)
                            {
                                @if (uyari.Baslik != null && uyari.Baslik.Contains("Minimum Stok Uyarısı"))
                                {
                                    // Minimum stok uyarısı için özel alert formatı
                                    var altDepoId = uyari.Mesaj.Contains("ALTDEPO_ID:") ? uyari.Mesaj.Split("ALTDEPO_ID:")[1] : "0";
                                    var temizMesaj = uyari.Mesaj.Replace(" ALTDEPO_ID:" + altDepoId, ""); // ID'yi mesajdan temizle
                                    
                                    <div class="alert alert-warning fade show" role="alert" data-uyari-id="@uyari.Id" data-alt-depo-id="@altDepoId">
                                        <strong>@uyari.Baslik</strong>
                                        <p class="mb-2">@Html.Raw(temizMesaj)</p>
                                        <p class="mb-3"><strong>İSTERSEN BAŞKA BİR DEPODAN TRANSFER GİRİŞİ ALMAK İÇİN ALT DEPO TESPİTİ YAPABİLİRİM</strong></p>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(@altDepoId)">
                                                🎯 Alt Depo Tespit Et
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm" onclick="silUyari(@uyari.Id)">
                                                🗑️ Sil
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    // Diğer uyarılar için normal format
                                    <div class="uyari-item @(uyari.Okundu ? "okundu" : "")" data-uyari-id="@uyari.Id">
                                        <div class="uyari-icon">
                                            <i class="@GetUyariIcon(uyari.Tip)"></i>
                                        </div>
                                        <div class="uyari-content">
                                            <div class="uyari-baslik">@uyari.Baslik</div>
                                            <div class="uyari-mesaj">@uyari.Mesaj</div>
                                            <div class="uyari-tarih">@uyari.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                                        </div>
                                        <div class="uyari-actions">
                                            @if (!string.IsNullOrEmpty(uyari.AksiyonUrl))
                                            {
                                                <a href="@uyari.AksiyonUrl" class="btn btn-sm btn-primary">
                                                    @(uyari.AksiyonText ?? "İşlem Yap")
                                                </a>
                                            }
                                            <button type="button" class="btn btn-sm btn-success" onclick="markAsRead(@uyari.Id)">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetActivityIcon(int hareketTip)
    {
        return hareketTip switch
        {
            1 => "fas fa-arrow-down",
            2 => "fas fa-exchange-alt",
            _ => "fa-solid fa-truck"
        };
    }

    private string GetActivityIconClass(int hareketTip)
    {
        return hareketTip switch
        {
            1 => "icon-success",
            2 => "icon-info",
            _ => "icon-secondary"
        };
    }

    private string GetActivityTypeText(int hareketTip)
    {
        return hareketTip switch
        {
            1 => "Giriş",
            2 => "Transfer",
            _ => "Diğer"
        };
    }

    private string GetActivityBadgeClass(int hareketTip)
    {
        return hareketTip switch
        {
            1 => "badge-success",
            2 => "badge-info",
            _ => "badge-secondary"
        };
    }

    private string GetUyariIcon(StokTakip.Models.UyariTipi tip)
    {
        return tip switch
        {
            StokTakip.Models.UyariTipi.Bilgi => "fas fa-info-circle text-info",
            StokTakip.Models.UyariTipi.Uyari => "fas fa-exclamation-triangle text-warning",
            StokTakip.Models.UyariTipi.Hata => "fas fa-times-circle text-danger",
            StokTakip.Models.UyariTipi.Basarili => "fas fa-check-circle text-success",
            _ => "fas fa-bell text-secondary"
        };
    }
}

