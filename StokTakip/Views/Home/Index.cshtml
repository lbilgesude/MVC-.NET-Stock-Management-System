<!-- Minimum Stok Uyarıları Modal -->
<div class="modal fade" id="minimumStokModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle"></i>
                    Stok Uyarısı
                </h5>
            </div>
            <div class="modal-body">
                <div id="uyariIcerik"></div>
            </div>
        </div>
    </div>
</div>

<!-- Alt Depo Tespit Modal -->
<div class="modal fade" id="altDepoTespitModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-search"></i>
                    Alt Depo Tespiti
                </h5>
            </div>
            <div class="modal-body">
                <div id="tespitIcerik"></div>
            </div>
        </div>
    </div>
</div>

<!-- Transfer Onay Modal -->
<div class="modal fade" id="transferOnayModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exchange-alt"></i>
                    Transfer Onayı
                </h5>
            </div>
            <div class="modal-body">
                <div id="transferOnayIcerik"></div>
            </div>
        </div>
    </div>
</div>

<script>
    // Sayfa yüklendiğinde minimum stok kontrolü yap
    $(document).ready(function() {
        // Uyarıları yükle
        yukleUyarilar();
        
        // Her 30 saniyede bir uyarıları yenile
        setInterval(yukleUyarilar, 30000);
        
        // Sayfa görünür olduğunda uyarıları yenile
        $(document).on('visibilitychange', function() {
            if (!document.hidden) {
                yukleUyarilar();
            }
        });
    });

    // Minimum stok kontrolü
    function kontrolMinimumStok() {
        $.ajax({
            url: '@Url.Action("GetMinimumStokUyarilari", "StokHarekets")',
            type: 'GET',
            success: function(response) {
                if (response.success && response.uyarilar && response.uyarilar.length > 0) {
                    // İlk uyarıyı göster
                    var uyari = response.uyarilar[0];
                    gosterMinimumStokUyarisi(uyari);
                }
            },
            error: function() {
                console.log('Minimum stok kontrolü yapılamadı.');
            }
        });
    }

    // TempData'dan gelen uyarıyı kontrol et
    @if (TempData["MinimumStokUyarisi"] != null)
    {
        <text>
        $(document).ready(function() {
            setTimeout(function() {
                // Yukarıdan düşen uyarıyı göster
                var uyariHtml = `
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong>⚠️ Minimum Stok Uyarısı!</strong> @TempData["MinimumStokUyarisi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        <div class="mt-2">
                            <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(@TempData["AltDepoId"])">
                                🎯 Alt Depo Tespit Et
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="dismissAlert()">
                                ❌ Kapat
                            </button>
                        </div>
                    </div>
                `;
                $('.dashboard-header').after(uyariHtml);
                
                // Aynı uyarıyı minimum stok uyarıları kartına da ekle (birebir aynı içerik)
                var kartUyariHtml = `
                    <div class="alert alert-warning fade show" role="alert">
                        <strong>⚠️ Minimum Stok Uyarısı!</strong> @TempData["MinimumStokUyarisi"]
                        <div class="mt-2">
                            <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(@TempData["AltDepoId"])">
                                🎯 Alt Depo Tespit Et
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="iptalEtUyari(this)">
                                ❌ İptal Et
                            </button>
                        </div>
                    </div>
                `;
                
                // Eğer kartta boş mesaj varsa kaldır
                if ($('#uyariListesi .uyari-bos').length > 0) {
                    $('#uyariListesi').html('');
                }
                
                // Uyarıyı karta ekle
                $('#uyariListesi').append(kartUyariHtml);
                
                // Uyarı sayısını güncelle
                var uyariSayisi = $('#uyariListesi .alert').length;
                $('#uyariSayisi').text(uyariSayisi);
                
            }, 500);
        });
        </text>
    }

    // Minimum stok uyarısını göster
    function gosterMinimumStokUyarisi(uyari) {
        var uyariHtml = `
            <div class="alert alert-warning">
                <h6><i class="fas fa-exclamation-triangle text-warning"></i> Dikkat!</h6>
                <p><strong>${uyari.DepoEslestirme.AltDepo.AltDepoAdi}</strong> alt deposunda <strong>${uyari.Stok.StokAd}</strong> ürününün stok miktarı azalıyor.</p>
                <p><strong>Mevcut Miktar:</strong> ${uyari.DurumMiktar}</p>
                <p class="mb-0"><strong>İSTERSEN BAŞKA BİR DEPODAN TRANSFER GİRİŞİ ALMAK İÇİN ALT DEPO TESPİTİ YAPABİLİRİM</strong></p>
            </div>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-success btn-lg me-3" onclick="tespitEtAltDepo(${uyari.DepoEslestirme.AltDepo.Id})">
                    <i class="fas fa-search"></i> TESPİT ET
                </button>
                <button type="button" class="btn btn-secondary btn-lg" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> HAYIR İSTEMİYORUM
                </button>
            </div>
        `;
        
        $('#uyariIcerik').html(uyariHtml);
        $('#minimumStokModal').modal('show');
    }

    // Alt depo tespit et
    function tespitEtAltDepo(mevcutAltDepoId) {
        $('#minimumStokModal').modal('hide');
        
        $.ajax({
            url: '@Url.Action("TespitEtAltDepo", "StokHarekets")',
            type: 'GET',
            data: { mevcutAltDepoId: mevcutAltDepoId },
            success: function(response) {
                if (response.success) {
                    gosterAltDepoTespit(response.altDepo, mevcutAltDepoId);
                } else {
                    alert('Uygun alt depo bulunamadı: ' + response.message);
                }
            },
            error: function() {
                alert('Alt depo tespiti yapılamadı.');
            }
        });
    }

    // Alt depo tespit sonucunu göster
    function gosterAltDepoTespit(altDepo, mevcutAltDepoId) {
        var tespitHtml = `
            <div class="alert alert-info">
                <h6><i class="fas fa-search text-info"></i> Tespit Sonucu</h6>
                <p><strong>${altDepo.adi}</strong> alt deposunun stok miktarı fazla gözüküyor.</p>
                <p class="mb-0"><strong>ORADAN BURAYA TRANSFER İŞLEMİ YAPMAK İSTER MİSİN?</strong></p>
            </div>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-success btn-lg w-100 mb-2" onclick="transferiYap(${altDepo.id}, ${mevcutAltDepoId})">
                    <i class="fas fa-exchange-alt"></i> TRANSFERİ YAP
                </button>
                <button type="button" class="btn btn-secondary w-100 btn-lg" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> HAYIR
                </button>
            </div>
        `;
        
        $('#tespitIcerik').html(tespitHtml);
        $('#altDepoTespitModal').modal('show');
    }

    // Transfer sayfasını aç
    function transferiYap(kaynakAltDepoId, hedefAltDepoId) {
        $('#altDepoTespitModal').modal('hide');
        window.location.href = '@Url.Action("TespitTransfer", "StokHarekets")?kaynakAltDepoId=' + kaynakAltDepoId + '&hedefAltDepoId=' + hedefAltDepoId;
    }

    // Uyarıyı kapat
    function dismissAlert() {
        $('.alert').fadeOut();
    }

    // Transfer sayfasını aç
    function transferYap(altDepoId) {
        window.location.href = '@Url.Action("Transfer", "StokHarekets")?hedefAltDepoId=' + altDepoId;
    }

    // Uyarıları yükle
    // Uyarı işlemleri
    function markAsRead(uyariId) {
        $.ajax({
            url: '@Url.Action("MarkUyariAsRead", "Home")',
            type: 'POST',
            data: { uyariId: uyariId },
            success: function(response) {
                if (response.success) {
                    $('[data-uyari-id="' + uyariId + '"]').addClass('okundu');
                    // Sayfayı yenile
                    location.reload();
                }
            },
            error: function() {
                alert('Uyarı işaretlenirken hata oluştu!');
            }
        });
    }

    function markAllAsRead() {
        $.ajax({
            url: '@Url.Action("MarkAllUyarilarAsRead", "Home")',
            type: 'POST',
            success: function(response) {
                if (response.success) {
                    // Sayfayı yenile
                    location.reload();
                }
            },
            error: function() {
                alert('Uyarılar işaretlenirken hata oluştu!');
            }
        });
    }

    function yukleUyarilar() {
        // Hem minimum stok uyarıları hem de tespit transfer uyarıları
        Promise.all([
            // Minimum stok uyarıları
            $.ajax({
                url: '@Url.Action("GetMinimumStokUyarilari", "StokHarekets")',
                type: 'GET'
            }),
            // Tespit transfer uyarıları (UyariService'den)
            $.ajax({
                url: '@Url.Action("GetUyarilarAsync", "Home")',
                type: 'GET'
            })
        ]).then(function(responses) {
            var minimumStokResponse = responses[0];
            var uyariServiceResponse = responses[1];
            
            var tumUyarilar = [];
            
            // Minimum stok uyarıları
            if (minimumStokResponse && minimumStokResponse.success && minimumStokResponse.uyarilar) {
                minimumStokResponse.uyarilar.forEach(function(uyari) {
                    uyari.tip = 'minimum-stok';
                    tumUyarilar.push(uyari);
                });
            }
            
            // UyariService'den gelen tespit transfer uyarıları
            if (uyariServiceResponse && uyariServiceResponse.success && uyariServiceResponse.uyarilar) {
                console.log('🎯 UyariService response:', uyariServiceResponse.uyarilar.length, 'uyarı');
                uyariServiceResponse.uyarilar.forEach(function(uyari) {
                    uyari.tip = 'tespit-transfer';
                    tumUyarilar.push(uyari);
                    console.log('➕ Tespit transfer uyarısı eklendi:', uyari.Baslik);
                });
            } else {
                console.log('❌ UyariService response boş veya hatalı:', uyariServiceResponse);
            }
            
            if (tumUyarilar.length > 0) {
                gosterUyarilar(tumUyarilar);
            } else {
                gosterBosUyari();
            }
        }).catch(function(error) {
            console.error('Uyarılar yüklenirken hata:', error);
            gosterBosUyari();
        });
    }

    // Uyarıları göster
    function gosterUyarilar(uyarilar) {
        var uyariHtml = '';
        
        // Uyarı sayısını güncelle ve göster
        $('#uyariSayisi').text(uyarilar.length).show();
        
        // Tümünü okundu butonunu göster
        if (uyarilar.length > 0) {
            $('#tumunuOkunduBtn').show();
        }
        
        uyarilar.forEach(function(uyari) {
            if (uyari.tip === 'minimum-stok') {
                // Minimum stok uyarısı
                uyariHtml += `
                    <div class="alert alert-warning fade show" role="alert">
                        <strong>⚠️ Minimum Stok Uyarısı!</strong>
                        <p class="mb-2"><strong>${uyari.altDepoAdi}</strong> alt deposunda <strong>${uyari.stokAd}</strong> ürününün stok miktarı azalıyor.</p>
                        <p class="mb-2"><strong>Mevcut Miktar:</strong> ${uyari.durumMiktar} <strong>Minimum:</strong> ${uyari.minimumMiktar}</p>
                        <p class="mb-3"><strong>İSTERSEN BAŞKA BİR DEPODAN TRANSFER GİRİŞİ ALMAK İÇİN ALT DEPO TESPİTİ YAPABİLİRİM</strong></p>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(${uyari.altDepoId})">
                                🎯 Alt Depo Tespit Et
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="iptalEtUyari(this)">
                                ❌ İptal Et
                            </button>
                        </div>
                    </div>
                `;
            } else if (uyari.tip === 'tespit-transfer') {
                // UyariService'den gelen kalıcı minimum stok uyarısı - YUKARIYA DÜŞEN BİLDİRİMİN AYNISI
                if (uyari.Baslik && uyari.Baslik.includes('Minimum Stok Uyarısı')) {
                    // AYNI BİLDİRİM - Minimum stok uyarısı
                    var altDepoId = uyari.Mesaj.includes('ALTDEPO_ID:') ? uyari.Mesaj.split('ALTDEPO_ID:')[1] : '0';
                    var temizMesaj = uyari.Mesaj.replace(/ ALTDEPO_ID:\d+/, ''); // ID'yi mesajdan temizle
                    
                    uyariHtml += `
                        <div class="alert alert-warning fade show" role="alert" data-uyari-id="${uyari.Id}" data-alt-depo-id="${altDepoId}">
                            <strong>${uyari.Baslik}</strong>
                            <p class="mb-2">${temizMesaj}</p>
                            <p class="mb-3"><strong>İSTERSEN BAŞKA BİR DEPODAN TRANSFER GİRİŞİ ALMAK İÇİN ALT DEPO TESPİTİ YAPABİLİRİM</strong></p>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary btn-sm" onclick="tespitEtAltDepo(${altDepoId})">
                                    🎯 Alt Depo Tespit Et
                                </button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="silUyari(${uyari.Id})">
                                    🗑️ Sil
                                </button>
                            </div>
                        </div>
                    `;
                } else {
                    // Diğer tespit transfer uyarıları
                    uyariHtml += `
                        <div class="alert alert-info fade show" role="alert" data-uyari-id="${uyari.Id}">
                            <strong>${uyari.Baslik}</strong>
                            <p class="mb-2">${uyari.Mesaj}</p>
                            <p class="mb-2"><small class="text-muted">${new Date(uyari.OlusturmaTarihi).toLocaleString('tr-TR')}</small></p>
                            <div class="d-flex gap-2">
                                <a href="${uyari.AksiyonUrl}" class="btn btn-success btn-sm">
                                    ${uyari.AksiyonText}
                                </a>
                                <button type="button" class="btn btn-danger btn-sm" onclick="silUyari(${uyari.Id})">
                                    🗑️ Sil
                                </button>
                            </div>
                        </div>
                    `;
                }
            }
        });
        
        $('#uyariListesi').html(uyariHtml);
    }

    // Boş uyarı göster
    function gosterBosUyari() {
        // Uyarı sayısını sıfırla ve gizle
        $('#uyariSayisi').text('0').hide();
        
        // Tümünü okundu butonunu gizle
        $('#tumunuOkunduBtn').hide();
        
        var bosHtml = `
            <div class="uyari-bos">
                <i class="fas fa-check-circle text-success"></i>
                <p>Tüm stoklar yeterli seviyede!</p>
                <p class="text-muted">Herhangi bir uyarı bulunmuyor.</p>
            </div>
        `;
        $('#uyariListesi').html(bosHtml);
    }

    // Uyarıyı iptal et
    function iptalEtUyari(button) {
        $(button).closest('.alert').fadeOut(300, function() {
            $(this).remove();
            // Uyarı sayısını güncelle
            var kalanUyariSayisi = $('#uyariListesi .alert').length;
            $('#uyariSayisi').text(kalanUyariSayisi);
            
            // Eğer hiç uyarı kalmadıysa boş mesaj göster
            if (kalanUyariSayisi <= 0) {
                gosterBosUyari();
            }
        });
    }
    
    // Uyarıyı sil
    function silUyari(uyariId) {
        if (confirm('Bu uyarıyı silmek istediğinizden emin misiniz?')) {
            $.ajax({
                url: '@Url.Action("SilUyari", "Home")',
                type: 'POST',
                data: { uyariId: uyariId },
                success: function(response) {
                    if (response.success) {
                        // Uyarıyı DOM'dan kaldır
                        $(`[data-uyari-id="${uyariId}"]`).remove();
                        
                        // Uyarı sayısını güncelle
                        var kalanUyariSayisi = $('#uyariListesi .alert').length;
                        $('#uyariSayisi').text(kalanUyariSayisi);
                        
                        // Eğer hiç uyarı kalmadıysa boş mesaj göster
                        if (kalanUyariSayisi <= 0) {
                            gosterBosUyari();
                        }
                        
                        console.log('Uyarı başarıyla silindi');
                    } else {
                        alert('Uyarı silinirken hata oluştu: ' + response.message);
                    }
                },
                error: function() {
                    alert('Uyarı silinirken hata oluştu!');
                }
            });
        }
    }
    
    // Transfer onaylama
    function onaylaTransfer(transferId) {
        if (confirm('Transfer işlemini onaylamak istediğinizden emin misiniz?')) {
            $.ajax({
                url: '@Url.Action("OnaylaTransfer", "StokHarekets")',
                type: 'POST',
                data: { transferId: transferId },
                success: function(response) {
                    if (response.success) {
                        alert('Transfer işlemi başarıyla onaylandı!');
                        // Uyarıları yenile
                        yukleUyarilar();
                    } else {
                        alert('Transfer onaylanırken hata oluştu: ' + response.message);
                    }
                },
                error: function() {
                    alert('Transfer onaylanırken hata oluştu!');
                }
            });
        }
    }
    
    // Transfer reddetme
    function reddetTransfer(transferId) {
        if (confirm('Transfer işlemini reddetmek istediğinizden emin misiniz?')) {
            $.ajax({
                url: '@Url.Action("ReddetTransfer", "StokHarekets")',
                type: 'POST',
                data: { transferId: transferId },
                success: function(response) {
                    if (response.success) {
                        alert('Transfer işlemi reddedildi!');
                        // Uyarıları yenile
                        yukleUyarilar();
                    } else {
                        alert('Transfer reddedilirken hata oluştu: ' + response.message);
                    }
                },
                error: function() {
                    alert('Transfer reddedilirken hata oluştu!');
                }
            });
        }
    }
    
    // Transfer düzenleme
    function duzenleTransfer(transferId) {
        window.location.href = '@Url.Action("DuzenleTransfer", "StokHarekets")?transferId=' + transferId;
    }
    
    // Gereksiz fonksiyonlar kaldırıldı - artık direkt tespitEtAltDepo ve transferYap kullanılıyor
</script>

